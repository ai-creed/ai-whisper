{
	"name": "ai-whisper",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e:ai-ezio-mount": "node scripts/ai-ezio-mount-relay-e2e.mjs",
		"e2e:ai-ezio-workflow": "node scripts/ai-ezio-full-workflow-e2e.mjs",
		"e2e:codex-events": "node scripts/codex-events-e2e.mjs",
		"smoke:bundle": "node scripts/bundle-selfcontained-smoke.mjs",
		"typecheck": "node packages/cli/scripts/stamp-ezio-provenance.mjs && tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check \"{package.json,pnpm-workspace.yaml,tsconfig*.json,vitest.config.ts,eslint.config.mjs,prettier.config.mjs}\" \"packages/*/{package.json,tsconfig.json}\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\"",
		"format:write": "prettier --write \"{package.json,pnpm-workspace.yaml,tsconfig*.json,vitest.config.ts,eslint.config.mjs,prettier.config.mjs}\" \"packages/*/{package.json,tsconfig.json}\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\""
	},
	"devDependencies": {
		"@ai-ezio/harness": "file:../ai-ezio/packages/harness",
		"@ai-ezio/protocol": "file:../ai-ezio/packages/protocol",
		"@ai-whisper/broker": "workspace:*",
		"@eslint/js": "^9.23.0",
		"@stylistic/eslint-plugin": "^2.13.0",
		"@types/node": "^22.13.10",
		"node-pty": "^1.1.0",
		"@types/react": "^19.2.14",
		"esbuild": "^0.28.1",
		"eslint": "^9.23.0",
		"globals": "^16.0.0",
		"ink": "^7.0.3",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.5.3",
		"react": "^19.2.6",
		"tsx": "^4.22.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.27.0",
		"vitest": "^3.2.6",
		"zod": "^3.25.76"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild",
			"node-pty"
		],
		"overrides": {
			"@ai-ezio/protocol": "file:../ai-ezio/packages/protocol",
			"@ai-ezio/harness": "file:../ai-ezio/packages/harness",
			"@ai-ezio/mcp-host": "file:../ai-ezio/packages/mcp-host",
			"fast-uri": "^3.1.2",
			"vite": "^7.3.2",
			"esbuild": "^0.28.1",
			"postcss": "^8.5.10",
			"hono": "^4.12.25"
		}
	}
}
